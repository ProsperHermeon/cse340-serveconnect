<%- include('partials/header', { title: title }) %>

<section class="form-page">
  <p class="crumb"><a href="/projects">&larr; All projects</a></p>
  <h1 class="section-title"><%= title %></h1>

  <form action="/new-project" method="POST" class="form-card">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input type="text" id="title" name="title" required maxlength="200" />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" required maxlength="1000"></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" required maxlength="200" />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input type="date" id="date" name="date" required />
    </div>

    <div class="form-group">
      <label for="organizationId">Sponsoring Organization</label>
      <select id="organizationId" name="organizationId" required>
        <option value="">-- Select an organization --</option>
        <% organizations.forEach((organization) => { %>
          <option value="<%= organization.organization_id %>"><%= organization.name %></option>
        <% }); %>
      </select>
    </div>

    <button type="submit" class="btn btn-primary">Create Service Project</button>
  </form>
</section>

<%- include('partials/footer') %>
