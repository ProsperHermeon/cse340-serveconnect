<%- include('partials/header', { title: title }) %>

<section class="form-page">
  <p class="crumb"><a href="/organization/<%= organizationDetails.organization_id %>">&larr; Back to organization</a></p>
  <h1 class="section-title"><%= title %></h1>

  <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="form-card">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input type="text" id="name" name="name" required maxlength="150"
             value="<%= organizationDetails.name %>" />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" required maxlength="500"><%= organizationDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input type="email" id="contactEmail" name="contactEmail" required
             value="<%= organizationDetails.contact_email %>" />
    </div>

    <div class="form-group">
      <label for="logoFilename">Logo Filename</label>
      <input type="text" id="logoFilename" name="logoFilename" required
             value="<%= organizationDetails.logo_filename %>" />
    </div>

    <button type="submit" class="btn btn-primary">Update Organization</button>
  </form>
</section>

<%- include('partials/footer') %>
