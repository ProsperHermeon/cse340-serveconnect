<%- include('partials/header', { title: title }) %>

<section class="page-head">
  <h1 class="section-title"><%= title %></h1>
  <p class="section-lead">
    The next few opportunities you can join, each sponsored by a partner
    organization. Select a project for full details.
  </p>
</section>

<section class="project-list">
  <ul class="project-items">
    <% projects.forEach((project) => { %>
      <%
        const projectDate = new Date(project.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC'
        });
      %>
      <li class="project-item">
        <p class="project-line">
          <span class="project-date"><%= projectDate %>:</span>
          <a class="project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
          <span class="project-org">(<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</span>
        </p>
        <p class="project-desc"><%= project.description %></p>
        <p class="project-location"><%= project.location %></p>
      </li>
    <% }); %>
  </ul>
</section>

<%- include('partials/footer') %>
