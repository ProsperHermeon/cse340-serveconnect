<%- include('partials/header', { title: title }) %>

<%
  const projectDate = new Date(project.date).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
  });
%>

<section class="detail">
  <p class="crumb"><a href="/projects">&larr; All projects</a></p>

  <h1 class="section-title"><%= project.title %></h1>
  <p class="detail-meta">
    Sponsored by
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>

  <ul class="fact-list">
    <li><span class="fact-label">Date</span><span class="fact-value"><%= projectDate %></span></li>
    <li><span class="fact-label">Location</span><span class="fact-value"><%= project.location %></span></li>
  </ul>

  <p class="detail-lead"><%= project.description %></p>

  <div class="tag-row">
    <% categories.forEach((category) => { %>
      <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
    <% }); %>
  </div>

  <% if (isLoggedIn) { %>
    <div class="volunteer-box">
      <% if (isVolunteering) { %>
        <p class="volunteer-status">You are volunteering for this project.</p>
        <form action="/unvolunteer/<%= project.project_id %>" method="POST">
          <input type="hidden" name="redirectTo" value="/project/<%= project.project_id %>" />
          <button type="submit" class="btn btn-ghost">Remove me as a volunteer</button>
        </form>
      <% } else { %>
        <form action="/volunteer/<%= project.project_id %>" method="POST">
          <button type="submit" class="btn btn-primary">Volunteer for this project</button>
        </form>
      <% } %>
    </div>
  <% } %>

  <% if (user && user.role_name === 'admin') { %>
    <p class="detail-actions">
      <a class="btn btn-ghost" href="/edit-project/<%= project.project_id %>">Edit project</a>
      <a class="btn btn-ghost" href="/assign-categories/<%= project.project_id %>">Edit categories</a>
    </p>
  <% } %>
</section>

<%- include('partials/footer') %>
