<%- include('partials/header', { title: title }) %>

<section class="page-head">
  <div class="page-head-row">
    <h1 class="section-title"><%= title %></h1>
    <% if (user && user.role_name === 'admin') { %>
      <a class="btn btn-primary" href="/new-category">Add a new category</a>
    <% } %>
  </div>
  <p class="section-lead">
    Every service project falls into one or more of these categories. Select a
    category to see the projects in it.
  </p>
</section>

<section class="card-grid">
  <% categories.forEach((category) => { %>
    <article class="card category-card">
      <div class="card-body">
        <h2 class="card-title">
          <a href="/category/<%= category.category_id %>"><%= category.name %></a>
        </h2>
        <% if (user && user.role_name === 'admin') { %>
          <p class="card-actions"><a href="/edit-category/<%= category.category_id %>">Edit</a></p>
        <% } %>
      </div>
    </article>
  <% }); %>
</section>

<%- include('partials/footer') %>
