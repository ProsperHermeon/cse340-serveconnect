<%- include('partials/header', { title: title }) %>

<section class="detail">
  <p class="crumb"><a href="/categories">&larr; All categories</a></p>

  <h1 class="section-title"><%= category.name %></h1>
  <p class="detail-lead">Service projects in the <%= category.name %> category.</p>
  <p class="detail-actions">
    <a class="btn btn-ghost" href="/edit-category/<%= category.category_id %>">Edit category</a>
  </p>
</section>

<section class="detail-projects">
  <% if (projects.length === 0) { %>
    <p class="empty">No service projects in this category yet.</p>
  <% } else { %>
    <ul class="project-items">
      <% projects.forEach((project) => { %>
        <%
          const projectDate = new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
          });
        %>
        <li class="project-item">
          <p class="project-line">
            <span class="project-date"><%= projectDate %>:</span>
            <a class="project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
            <span class="project-org">(<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</span>
          </p>
          <p class="project-desc"><%= project.description %></p>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
